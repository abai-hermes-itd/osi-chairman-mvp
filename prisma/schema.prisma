// Настройка подключения к твоей базе Neon
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Пользователь кабинета (председатель ОСИ и др.)
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?  // bcrypt-хэш; null, пока пароль не задан
  name         String?
  role         String   @default("CHAIRMAN") // CHAIRMAN, ADMIN
  osiId        String?
  osi          Osi?     @relation(fields: [osiId], references: [id])
  createdAt    DateTime @default(now())
  passwordTokens PasswordToken[]
}

// ОСИ / дом (паспорт МКД; зеркалит data/config/house.md)
model Osi {
  id             String   @id @default(cuid())
  bin            String   @unique // БИН; "temp" пока не заполнен
  name           String?
  managementType String?  // OSI, KSK, PT
  city           String?
  address        String?
  totalFlats     Int?
  status         String   @default("PENDING_SETUP") // PENDING_SETUP, CONFIGURED, ACTIVE
  users          User[]
  residentRequests ResidentRequest[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Таблица для хранения документов (сканы актов, фото квитанций)
model Document {
  id          String   @id @default(cuid())
  fileName    String?  // Имя файла скана
  docType     String   // "Акт сверки", "Квитанция" и т.д.
  rawText     String   // Весь распознанный текст от агента
  summary     String?  // Краткая выжимка (суть документа)
  processedAt DateTime @default(now())
  status      String   @default("NEW") // NEW, PROCESSED, ERROR
}

// Логи работы твоих агентов Skill MD
model AgentLog {
  id        String   @id @default(cuid())
  agentName String   // Какой агент работал (Vision, Parser)
  action    String   // Что именно сделал
  result    String?  // Результат (успех/текст ошибки)
  createdAt DateTime @default(now())
}

// Заявка председателя на доступ; проверяется оператором вручную
model RegistrationRequest {
  id           String    @id @default(cuid())
  email        String    // в нижнем регистре
  name         String    // ФИО председателя
  phone        String
  osiBin       String    // БИН ОСИ, 12 цифр
  osiName      String?
  city         String?
  address      String?
  basis        String?   // основание полномочий: № протокола собрания, дата и т.п.
  status       String    @default("PENDING") // PENDING, APPROVED, REJECTED
  rejectReason String?
  reviewedById String?   // id оператора (User.id), без внешнего ключа
  reviewedAt   DateTime?
  userId       String?   // созданный пользователь при одобрении
  createdAt    DateTime  @default(now())

  @@index([status, createdAt])
  @@index([email])
  @@index([osiBin])
}

// Одноразовые ссылки «задать пароль». В БД хранится только SHA-256 токена.
model PasswordToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Заявка жильца (принимает председатель). Не путать с RegistrationRequest (заявка на доступ).
model ResidentRequest {
  id           String         @id @default(cuid())
  osiId        String
  osi          Osi            @relation(fields: [osiId], references: [id])
  createdById  String         // id пользователя, принявшего заявку (без внешнего ключа)
  residentName String?
  apartment    String?
  entrance     String?
  category     String         @default("OTHER") // LEAK, ELEVATOR, LIGHTING, GARBAGE, OTHER
  urgency      String         @default("NORMAL") // LOW, NORMAL, HIGH
  description  String
  status       String         @default("NEW") // NEW, IN_PROGRESS, DONE, CANCELLED
  media        RequestMedia[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([osiId, status, createdAt])
}

// Фото к заявке. На этапе MVP хранится в базе (сжатое на клиенте); позже заменяется внешним хранилищем.
model RequestMedia {
  id        String          @id @default(cuid())
  requestId String
  request   ResidentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind      String          @default("BEFORE") // BEFORE, AFTER
  mimeType  String          // image/jpeg, image/png, image/webp
  size      Int
  data      Bytes
  createdAt DateTime        @default(now())

  @@index([requestId])
}
