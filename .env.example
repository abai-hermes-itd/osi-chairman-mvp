# Скопируйте в .env (файл .env не коммитится). Реальные значения в репозиторий не вносить.
# Пулированная строка Neon (в хосте есть -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=require"
# Секрет подписи сессий, минимум 32 символа (случайная строка)
SESSION_SECRET=""
# Только для npm run db:seed
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
# Только для локальной разработки (next dev): отключает вход. В production игнорируется.
# DEV_AUTH_BYPASS=1
